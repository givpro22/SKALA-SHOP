# docker-compose 용 환경변수. 실제 .env 는 커밋하지 않는다(.gitignore 포함).
#   cp .env.example .env  후 값을 바꿔 쓴다.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=skalashop

# --- 백엔드 ---
# 빈 MySQL로 처음 기동할 때는 update 여야 테이블이 생성된다.
# 스키마가 고정된 뒤에는 validate 로 조일 수 있다.
DDL_AUTO=update
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- 프론트엔드 ---
# 브라우저가 호출하는 주소다. 컨테이너 내부 이름(backend)이 아니라 호스트에서 보이는 주소여야 한다.
# 빌드 시점에 번들로 인라인되므로 바꾸면 프론트 이미지를 다시 빌드해야 한다.
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=3000

# JWT 서명키 — prod(컨테이너)에서는 **반드시** 주입해야 한다.
#
# 넣지 않으면 백엔드가 기동에 실패한다(ProdEnvironmentGuard). 의도된 동작이다 —
# application.yml 의 개발용 기본값으로 뜨면 배포본에서 토큰 위조가 가능해진다.
#
# HS256 은 32바이트 이상을 요구한다. 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# --- ADMIN 부트스트랩 (계약 §9.4.5) ---
#
# **비워 둔 것은 실수가 아니다.** JWT_SECRET 과 같은 이유로 기본값을 주지 않는다 —
# 예시 값을 적어 두면 그 값이 그대로 배포되고, 소스를 본 사람이 관리자로 로그인한다.
#
# 왜 필요한가: ADMIN 을 만드는 경로가 local 시드(@Profile("local")) 하나뿐이라
# 깨끗한 prod 배포에는 ADMIN 이 영원히 없었다. POST /api/products 가 hasRole("ADMIN") 이므로
# **카탈로그를 채울 수 없는 빈 쇼핑몰로 굳는다.** 그런데 앱은 정상으로 보인다 —
# 기동 성공·헬스체크 통과·로그 깨끗·조회 API 200. 관리 API 만 403 인데 그건 정상 응답이다.
#
# 언제 필요한가: **ADMIN 이 0건일 때만.** 이미 있으면 이 값들은 무시되고
# 기존 계정을 덮어쓰지 않는다(운영 중 환경변수 변경만으로 비밀번호가 리셋되면 안 된다).
# 0건인데 비어 있으면 **기동에 실패한다** — 뜨더라도 아무도 쓸 수 없는 배포본이기 때문이다.
#
# 형식: ADMIN_USERNAME 은 이메일 형식 100자 이하, ADMIN_PASSWORD 는 8~72자(§8.2 와 같은 규칙).
# 비밀번호 회전: 값을 바꾸고 → 기존 ADMIN 계정을 지우고 → 재기동한다(0건이 되어 다시 만들어진다).
ADMIN_USERNAME=
ADMIN_PASSWORD=
