# docker-compose 용 환경변수. 실제 .env 는 커밋하지 않는다(.gitignore 포함).
#   cp .env.example .env  후 값을 바꿔 쓴다.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=skalashop

# --- 백엔드 ---
# 빈 MySQL로 처음 기동할 때는 update 여야 테이블이 생성된다.
# 스키마가 고정된 뒤에는 validate 로 조일 수 있다.
DDL_AUTO=update
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- 프론트엔드 ---
# 브라우저가 호출하는 주소다. 컨테이너 내부 이름(backend)이 아니라 호스트에서 보이는 주소여야 한다.
# 빌드 시점에 번들로 인라인되므로 바꾸면 프론트 이미지를 다시 빌드해야 한다.
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=3000

# JWT 서명키 — prod(컨테이너)에서는 **반드시** 주입해야 한다.
#
# 넣지 않으면 백엔드가 기동에 실패한다(ProdEnvironmentGuard). 의도된 동작이다 —
# application.yml 의 개발용 기본값으로 뜨면 배포본에서 토큰 위조가 가능해진다.
#
# HS256 은 32바이트 이상을 요구한다. 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
